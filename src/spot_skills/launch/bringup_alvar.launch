<!-- Launch the requested nodes to track AR tags using ar_track_alvar -->
<launch>

    <!-- =========  GLOBAL ARGS  ========= -->

    <!-- Require the path to a YAML file configuring the AR marker system -->
    <arg name="markers_yaml_path" default="$(find spot_skills)/config/markers.yaml"/>

    <!-- Require a path specifying where estimated object poses are output -->
    <arg name="output_yaml_path" default="$(find spot_skills)/config/object_poses.yaml"/>

    <!-- Require a path specifying a YAML file containing known object poses -->
    <arg name="known_poses_yaml_path" default="$(find spot_skills)/config/known_poses.yaml"/>

    <!-- Marker sizes (cm) -->
    <arg name="small_marker_size_cm" default="4.4"/>
    <arg name="medium_marker_size_cm" default="7.62"/>
    <arg name="large_marker_size_cm" default="18.5"/>

    <!-- Tracker parameters -->
    <arg name="max_new_marker_error" default="0.08"/>
    <arg name="max_track_error" default="0.2"/>

    <!-- Optionally, replace /tf with a dummy topic -->
    <arg name="tf_topic" default="dummy_tf"/>

    <!-- =========  HAND CAMERA  ========= -->
    <node name="ar_single_hand_small" pkg="ar_track_alvar" type="individualMarkersNoKinect" respawn="true" output="screen">
        <param name="marker_size" value="$(arg small_marker_size_cm)" type="double"/>
        <param name="max_new_marker_error" value="$(arg max_new_marker_error)" type="double"/>
        <param name="max_track_error" value="$(arg max_track_error)" type="double"/>
        <param name="output_frame" value="hand_color_image_sensor"/>
        <remap from="camera_image" to="/spot/camera/hand_color/image"/>
        <remap from="camera_info" to="/spot/camera/hand_color/camera_info"/>
        <remap from="ar_pose_marker" to="/ar_pose_marker/hand"/>
        <remap from="tf" to="$(arg tf_topic)"/>
    </node>

    <!-- =========  FRONT‑LEFT CAMERA  ========= -->
    <node name="ar_single_frontleft_small" pkg="ar_track_alvar" type="individualMarkersNoKinect" respawn="true" output="screen">
        <param name="marker_size" value="$(arg small_marker_size_cm)" type="double"/>
        <param name="max_new_marker_error" value="$(arg max_new_marker_error)" type="double"/>
        <param name="max_track_error" value="$(arg max_track_error)" type="double"/>
        <param name="output_frame" value="frontleft_fisheye"/>
        <remap from="camera_image" to="/spot/camera/frontleft/image"/>
        <remap from="camera_info" to="/spot/camera/frontleft/camera_info"/>
        <remap from="ar_pose_marker" to="/ar_pose_marker/frontleft"/>
        <remap from="tf" to="$(arg tf_topic)"/>
    </node>

    <!-- =========  FRONT‑RIGHT CAMERA  ========= -->
    <node name="ar_single_frontright_small" pkg="ar_track_alvar" type="individualMarkersNoKinect" respawn="true" output="screen">
        <param name="marker_size" value="$(arg small_marker_size_cm)" type="double"/>
        <param name="max_new_marker_error" value="$(arg max_new_marker_error)" type="double"/>
        <param name="max_track_error" value="$(arg max_track_error)" type="double"/>
        <param name="output_frame" value="frontright_fisheye"/>
        <remap from="camera_image" to="/spot/camera/frontright/image"/>
        <remap from="camera_info" to="/spot/camera/frontright/camera_info"/>
        <remap from="ar_pose_marker" to="/ar_pose_marker/frontright"/>
        <remap from="tf" to="$(arg tf_topic)"/>
    </node>

    <!-- Launch a node to forward transforms from ar_track_alvar to /tf -->
    <!--<node name="fiducial_tracker_node" pkg="spot_skills" type="fiducial_tracker_node.py" output="screen" required="true">
        <param name="markers_yaml_path" value="$(arg markers_yaml_path)"/>
        <param name="output_yaml_path" value="$(arg output_yaml_path)"/>
        <param name="marker_topic_prefix" value="/ar_pose_marker"/>
        <param name="known_poses_yaml_path" value="$(arg known_poses_yaml_path)"/>
    </node>-->

</launch>
