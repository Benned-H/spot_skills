<!-- Launch all nodes to control Spot, simulated or real, using MoveIt

    This file launches/includes the following nodes/launch files:
        - moveit_core.launch - All MoveIt-specific nodes for controlling any robot
        - fake_gripper_action_server - Fake controller for Spot's gripper (if simulated robot)
        - bringup_spot_driver.launch - Connects to Spot using its ROS driver (if real robot)
        - spot_wrapper_node - Connects to Spot using the ROS wrapper (to control real robot)
-->
<launch>

    <!-- For safety reasons, do not assume which Spot is being used -->
    <arg name="spot_name"/>

    <!-- Are we using a simulated (default) or real Spot? -->
    <arg name="real_robot" default="false"/>

    <!-- If we're actively running TAMP, give the planner control over the robot joint states -->
    <arg name="tamp_controls_robot" default="false"/>

    <!-- Path to a YAML file specifying the environment state -->
    <arg name="env_yaml_path" default="$(find spot_skills)/config/env.yaml"/>
    <param name="/spot/env_yaml_path" value="$(arg env_yaml_path)"/>

    <!-- Runtime state overlay persistence parameters -->
    <arg name="state_overlay_enabled" default="true"/>
    <arg name="state_overlay_dir" default="/tmp/spot_skills/state_overlays"/>
    <arg name="state_overlay_stale_after_s" default="300.0"/>
    <arg name="state_overlay_autoload" default="true"/>
    <arg name="state_overlay_autosave" default="true"/>
    <arg name="state_overlay_clear_on_reset" default="true"/>
    <param name="/spot/state_overlay/enabled" value="$(arg state_overlay_enabled)"/>
    <param name="/spot/state_overlay/dir" value="$(arg state_overlay_dir)"/>
    <param name="/spot/state_overlay/stale_after_s" value="$(arg state_overlay_stale_after_s)"/>
    <param name="/spot/state_overlay/autoload" value="$(arg state_overlay_autoload)"/>
    <param name="/spot/state_overlay/autosave" value="$(arg state_overlay_autosave)"/>
    <param name="/spot/state_overlay/clear_on_reset" value="$(arg state_overlay_clear_on_reset)"/>

    <!-- Load an API key for Gemini Robotics-ER 1.5 from YAML -->
    <arg name="gemini_api_yaml" value="$(find spot_skills)/secrets/gemini_api_key.yaml" />

    <!-- Launch the core nodes MoveIt uses to control a robot (simulated or real) -->
    <include file="$(dirname)/moveit_core.launch">
        <!-- Load/override the robot description (URDF) using MoveIt -->
        <arg name="load_robot_description" value="true"/>
        <arg name="real_robot" value="$(arg real_robot)"/>
        <arg name="tamp_controls_robot" value="$(arg tamp_controls_robot)"/>
    </include>

    <!-- If we're running in simulation, launch a fake controller for Spot's gripper -->
    <group unless="$(arg real_robot)">
        <node name="fake_gripper_action_server" pkg="spot_skills" type="fake_gripper_action_server.py" output="screen"/>
    </group>

    <!-- If we're running on the real robot, launch the Spot ROS driver and wrapper -->
    <group if="$(arg real_robot)">

        <!-- Launch the Spot ROS 1 driver for the named Spot -->
        <include file="$(find spot_skills)/launch/bringup_spot_driver.launch">
            <arg name="spot_name" value="$(arg spot_name)"/>

            <!-- Load Spot's URDF/SRDF using MoveIt, not the Spot driver -->
            <arg name="load_robot_description" value="false"/>
        </include>

        <!-- Launch a node to map Spot's joint states into link transforms -->
        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

        <!-- Launch a wrapper providing an interface to Spot for ROS and MoveIt -->
        <node name="spot_wrapper_node" pkg="spot_skills" type="spot_wrapper_node.py" output="screen" required="true">
            <rosparam file="$(arg gemini_api_yaml)" command="load" />
        </node>

    </group>
</launch>
